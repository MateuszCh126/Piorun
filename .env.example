# Core runtime
PIORUN_LLM_BASE_URL=http://localhost:8080/v1
PIORUN_LLM_HEALTH_TIMEOUT_SECONDS=3
PIORUN_OPS_API_HOST=127.0.0.1
PIORUN_OPS_API_PORT=8787
PIORUN_MODEL_NAME=gemma-4-9b
PIORUN_CONTEXT_MAX_TOKENS=12000
PIORUN_CONTEXT_KEEP_RECENT_TOKENS=5000
PIORUN_SUMMARY_REFRESH_EVERY_MESSAGES=8
PIORUN_SUMMARY_RECENT_LIMIT=40
PIORUN_AUTONOMY_ENABLED=false
PIORUN_AUTONOMY_INTERVAL_SECONDS=300
PIORUN_AUTONOMY_MIN_CONFIDENCE_PERCENT=75
PIORUN_AUTONOMY_MAX_AUTOEXEC_PER_HOUR=4
PIORUN_AUTONOMY_MAX_WEB_RESULTS_PER_TICK=2
PIORUN_AUTONOMY_MAX_AUTOEXEC_PER_TICK=2
PIORUN_AUTONOMY_ACTION_COOLDOWN_MINUTES=180
PIORUN_AUTONOMY_HEARTBEAT_COOLDOWN_MINUTES=720
PIORUN_AUTONOMY_PLANNER_TIMEOUT_SECONDS=60
PIORUN_AUTONOMY_PLANNER_MAX_TOKENS=1200

# Workspace/project
# Example: C:\Users\your_user\Desktop\mat
PIORUN_WORKSPACE_ROOT=C:\Users\gamin\Desktop\mat

# Runtime data (.piorun)
# Example: C:\Users\your_user\.piorun
PIORUN_RUNTIME_ROOT=C:\Users\gamin\.piorun
PIORUN_HISTORY_DB=C:\Users\gamin\.piorun\history.db
PIORUN_TASKS_DB=C:\Users\gamin\.piorun\tasks.db
PIORUN_GCAL_TOKEN_PATH=C:\Users\gamin\.piorun\token.json

# Workdir / outputs
# Example: C:\Users\your_user\Desktop\Piorun
PIORUN_WORKDIR=C:\Users\gamin\Desktop\Piorun
PIORUN_SESSIONS_ROOT=C:\Users\gamin\Desktop\Piorun\sessions
PIORUN_NOTES_ROOT=C:\Users\gamin\Desktop\Piorun\notes
PIORUN_AUTONOMY_LOG=C:\Users\gamin\Desktop\Piorun\autonomous_log.md
PIORUN_ATTACHMENTS_DIR=C:\Users\gamin\Desktop\Piorun
PIORUN_ALLOWED_ROOT=C:\Users\gamin\Desktop\Piorun
PIORUN_WHISPER_MODEL_PATH=C:\Users\gamin\Desktop\Piorun\whisper-large-v3
PIORUN_LECTURE_CLEANUP_AFTER_PROCESS=true
PIORUN_LECTURE_SCREENSHOT_INTERVAL_SECONDS=30
PIORUN_LECTURE_SCREENSHOT_MAX_WIDTH=1600
PIORUN_LECTURE_SCREENSHOT_JPEG_QUALITY=72
PIORUN_LECTURE_AUDIO_CHANNELS=1
PIORUN_LECTURE_SILENCE_WARN_SECONDS=60
PIORUN_LECTURE_SILENCE_RMS_THRESHOLD=60
PIORUN_LECTURE_EXPORT_DOCX=false

# Integration credentials
PIORUN_AGENT_CREDENTIALS_PATH=C:\Users\gamin\Desktop\mat\agent_credentials.json
PIORUN_GCAL_CREDENTIALS_PATH=C:\Users\gamin\Desktop\mat\credentials.json

# Local storage
PIORUN_MEMORY_VECTOR_DB=C:\Users\gamin\Desktop\mat\.memory_db

# Vector memory (recall) - docs/vector-memory-design.md
PIORUN_MEMORY_RECALL_ENABLED=true
PIORUN_MEMORY_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
PIORUN_MEMORY_RECALL_TOP_K=5
PIORUN_MEMORY_RECALL_MAX_DISTANCE=0.65
PIORUN_SANDBOX_DIR=C:\Users\gamin\Desktop\mat\.sandbox
PIORUN_BACKUP_DIR=C:\Users\gamin\.piorun\backups
PIORUN_AUTONOMY_STATE_DIR=C:\Users\gamin\.piorun\autonomy
